     }
     return proxy->UpdateSimActiveState(slotId, activeStateResult);
 }
+
+int32_t TelephonyStateRegistryClient::UpdateCommunicationState(int32_t slotId, bool is5A)
+{
+    auto proxy = GetProxy();
+    if (proxy == nullptr) {
+        TELEPHONY_LOGE("proxy is null!");
+        return TELEPHONY_ERR_IPC_CONNECT_STUB_FAIL;
+    }
+    return proxy->UpdateCommunicationState(slotId, is5A);
+}
 } // namespace Telephony
 }

diff --git a/base/telephony/core_service/frameworks/native/src/telephony_state_registry_proxy.cpp b/base/telephony/core_service/frameworks/native/src/telephony_state_registry_proxy.cpp
index 11b3522f0984d3da81a0643127c367688a59d43f..2381d46959ca81e765d4e281bdb136f1cf20a798 100644
--- a/base/telephony/core_service/frameworks/native/src/telephony_state_registry_proxy.cpp
+++ b/base/telephony/core_service/frameworks/native/src/telephony_state_registry_proxy.cpp
@@ -457,5 +457,32 @@ int32_t TelephonyStateRegistryProxy::UpdateSimActiveState(int32_t slotId, bool a
     }
     return TELEPHONY_ERR_IPC_CONNECT_STUB_FAIL;
 }
+
+int32_t TelephonyStateRegistryProxy::UpdateCommunicationState(int32_t slotId, bool is5A)
+{
+    MessageOption option;
+    MessageParcel in;
+    MessageParcel out;
+    if (!in.WriteInterfaceToken(TelephonyStateRegistryProxy::GetDescriptor())) {
+        return TELEPHONY_ERR_WRITE_DESCRIPTOR_TOKEN_FAIL;
+    }
+    if (!in.WriteInt32(slotId)) {
+        return TELEPHONY_ERR_WRITE_DATA_FAIL;
+    }
+    if (!in.WriteBool(is5A)) {
+        return TELEPHONY_ERR_WRITE_DATA_FAIL;
+    }
+    sptr<IRemoteObject> remote = Remote();
+    if (remote == nullptr) {
+        return TELEPHONY_ERR_IPC_CONNECT_STUB_FAIL;
+    }
+    int result = remote->SendRequest(
+        static_cast<uint32_t>(StateNotifyInterfaceCode::COMMUNICATION_STATE), in, out, option);
+    if (result == ERR_NONE) {
+        result = out.ReadInt32();
+        return result;
+    }
+    return TELEPHONY_ERR_IPC_CONNECT_STUB_FAIL;
+}
 } // namespace Telephony
 } // namespace OHOS
